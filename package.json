{
  "name": "reminder-note",
  "version": "1.0.0",
  "private": true,
  "description": "Personal reminder + notes PWA frontend",
  "scripts": {
    "dev": "concurrently -k -n css,js \"npm:dev:css\" \"npm:dev:js\"",
    "dev:css": "tailwindcss -i ./public/css/tailwind.src.css -o ./public/css/style.css --watch",
    "dev:js": "esbuild ./public/js/app.js --bundle --format=esm --outfile=./public/dist/app.js --sourcemap --watch",
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./public/css/tailwind.src.css -o ./public/css/style.css --minify",
    "build:js": "esbuild ./public/js/app.js --bundle --format=esm --outfile=./public/dist/app.js --minify"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "alpinejs": "^3.14.7",
    "canvas-confetti": "^1.9.3",
    "chrono-node": "^2.7.7",
    "dexie": "^4.0.10",
    "dompurify": "^3.2.3",
    "lucide": "^0.469.0",
    "marked": "^14.1.4"
  }
}
